# Copy to .env and fill in. Never commit .env.
# Sarvam AI subscription key (https://dashboard.sarvam.ai). Leave blank to run
# the deterministic offline agent — the whole flow still works end to end.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b
SARVAM_TIMEOUT=20

DATABASE_PATH=paypilot.db
CONSENT_TTL_DAYS=30

# Demo simulator only - set false before exposing this service to real users.
DEMO_MODE=true
# Production should specify actual allowed browser origins.
CORS_ORIGINS=
